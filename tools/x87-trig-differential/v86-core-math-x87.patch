+    fn cr_sincosf(x: f32, sine: *mut f32, cosine: *mut f32);
+}
+
 const FPU_C0: u16 = 0x100;
 const FPU_C1: u16 = 0x200;
 const FPU_C2: u16 = 0x400;
@@ -22,6 +26,66 @@ const FPU_EX_U: u16 = 1 << 4; // underflow
 const FPU_EX_P: u16 = 1 << 5; // precision
 const FPU_EX_SF: u16 = 1 << 6;
 
+// Native x87 reduces finite inputs only while |x| < 2^63.
+const FPU_TRIG_LIMIT_EXPONENT: u16 = 0x403E;
+// Exhaustively validated for every binary32 magnitude below 2^19. The game
+// corpus reaches only 0x41bf6214 (< 24); larger values retain v86's generic
+// f64 implementation because AMD x87 and correctly-rounded sinf diverge there.
+const FPU_TRIG_PROVEN_F32_LIMIT: u32 = 0x4900_0000;
+
+fn f80_reloadable_f32(value: F80) -> Option<i32> {
+    F80::clear_exception_flags();
+    let bits = value.to_f32();
+    if F80::get_exception_flags() != 0 {
+        return None;
+    }
+    F80::clear_exception_flags();
+    let roundtrip = F80::of_f32(bits);
+    if F80::get_exception_flags() == 0 &&
+        roundtrip.mantissa == value.mantissa &&
+        roundtrip.sign_exponent == value.sign_exponent
+    {
+        Some(bits)
+    }
+    else {
+        None
+    }
+}
+
+unsafe fn fpu_trig_f32(value: F80) -> Option<(F80, F80)> {
+    let bits = f80_reloadable_f32(value)? as u32;
+    let absolute = bits & 0x7FFF_FFFF;
+    let exponent = absolute & 0x7F80_0000;
+    let fraction = absolute & 0x007F_FFFF;
+
+    if exponent == 0x7F80_0000 {
+        let quiet_nan = fraction != 0 && fraction & 0x0040_0000 != 0;
+        if !quiet_nan {
+            *fpu_status_word |= FPU_EX_I;
+        }
+    }
+    else if absolute != 0 {
+        *fpu_status_word |= FPU_EX_P;
+        if exponent == 0 {
+            *fpu_status_word |= FPU_EX_D;
+        }
+    }
+
+    if absolute >= FPU_TRIG_PROVEN_F32_LIMIT {
+        return None;
+    }
+
+    let mut sine = 0.0f32;
+    let mut cosine = 0.0f32;
+    cr_sincosf(f32::from_bits(bits), &mut sine, &mut cosine);
+    Some((F80::of_f32(sine.to_bits() as i32), F80::of_f32(cosine.to_bits() as i32)))
+}
+
+fn fpu_trig_out_of_range(value: F80) -> bool {
+    let exponent = value.sign_exponent & 0x7FFF;
+    exponent >= FPU_TRIG_LIMIT_EXPONENT && exponent != 0x7FFF
+}
