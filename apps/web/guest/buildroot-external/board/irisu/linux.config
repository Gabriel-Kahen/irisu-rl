CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
CONFIG_EXPERT=y
CONFIG_HZ_100=y
# CONFIG_SYSVIPC is not set
# CONFIG_SUSPEND is not set
# CONFIG_ACPI is not set
CONFIG_CPU_IDLE=y
# CONFIG_GCC_PLUGINS is not set
CONFIG_MEMFD_CREATE=y
CONFIG_NET=y
